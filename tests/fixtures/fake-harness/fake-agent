#!/usr/bin/env python3
"""Shared stand-in. FAKE_MODE is ok, slow, signed_out, or fail."""

from __future__ import annotations

import json
import os
import sys
import time


def main() -> int:
    stdin = sys.stdin.buffer.read()
    mode = os.environ.get("FAKE_MODE", "ok")
    if mode == "slow":
        time.sleep(float(os.environ["FAKE_SLEEP"]))
        mode = "ok"
    if mode == "ok":
        sys.stdout.write(json.dumps({"text": stdin.decode("utf-8", "replace")}) + "\n")
        return 0
    if mode == "signed_out":
        who = os.path.basename(os.environ.get("FAKE_ARGV0", ""))
        line = (
            "Not logged in. Authentication required. Please log in. cursor-agent login\n"
            if who == "cursor-agent"
            else "Error: Invalid API key · Please run /login\n"
        )
        sys.stdout.write(line)
        return 1
    sys.stdout.write("boom\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
